rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and sub-collections are strictly isolated by User ID (UID)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User tickets collection
      match /tickets/{ticketId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User prediction history & calibration snapshots
      match /predictions/{predictionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User rollover challenges & progression
      match /rollovers/{challengeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /days/{dayNumber} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Prohibit all other unauthenticated or cross-user root access
    match /{document=**} {
      allow read, write: false;
    }
  }
}
